# Backend REST base. Leave empty in dev to use the Vite proxy (recommended).
# In production set to your deployed backend, e.g. https://your-backend.example.com/api
VITE_API_URL=

# Realtime (Pusher protocol). For Pusher Channels set the key + cluster.
VITE_PUSHER_KEY=
VITE_PUSHER_CLUSTER=mt1

# For a self-hosted / soketi broker, also set host/port/TLS:
# VITE_PUSHER_HOST=localhost
# VITE_PUSHER_PORT=6001
# VITE_PUSHER_USE_TLS=false
