# --- Server ---
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/messenger?schema=public

# --- Auth ---
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# --- Uploads (avatars stored as data URLs; keep small) ---
MAX_UPLOAD_BYTES=1048576

# --- Realtime (Pusher protocol) ---
# In production use Pusher Channels (https://pusher.com) credentials.
# Leave PUSHER_HOST empty to use Pusher cloud with PUSHER_CLUSTER.
# For a self-hosted/soketi broker, set PUSHER_HOST / PUSHER_PORT / PUSHER_USE_TLS.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=mt1
# PUSHER_HOST=127.0.0.1
# PUSHER_PORT=6001
# PUSHER_USE_TLS=false
